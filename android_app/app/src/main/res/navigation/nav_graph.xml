<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_login">

    <fragment
        android:id="@+id/navigation_login"
        android:name="com.sparkshield.android.ui.login.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_loginFragment_to_navigation_dashboard"
            app:destination="@id/navigation_dashboard"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.sparkshield.android.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/navigation_monitor"
        android:name="com.sparkshield.android.ui.monitor.MonitorFragment"
        android:label="Monitor"
        tools:layout="@layout/fragment_monitor" />

    <fragment
        android:id="@+id/navigation_detection"
        android:name="com.sparkshield.android.ui.detection.DetectionFragment"
        android:label="Detection"
        tools:layout="@layout/fragment_detection" />

    <fragment
        android:id="@+id/navigation_history"
        android:name="com.sparkshield.android.ui.history.HistoryFragment"
        android:label="History"
        tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.sparkshield.android.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/navigation_simulation"
        android:name="com.sparkshield.android.simulation.SimulationLabFragment"
        android:label="Simulation Lab" />

</navigation>
